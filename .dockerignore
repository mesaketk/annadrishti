# Build context hygiene: keep the image small and never ship raw data.
.git
.gitignore
.DS_Store
**/.DS_Store
.pytest_cache
**/__pycache__
**/*.pyc
.venv
venv

# raw / bulky inputs
data
set 1
set 2
INDIA_DISTRICTS.geojson
pipeline
docs

# frontend: built inside the image
**/node_modules
web/dist

# artifacts: ship only what the API serves
artifacts/*
!artifacts/districts.json
!artifacts/kpis.json
!artifacts/timeseries
!artifacts/history
artifacts/timeseries_climate

# api tests and local junk
api/tests
deploy

# GCP service-account keys — never ship
aibuildercup-*.json
gcp-sa*.json
*.iam.json
ee-chvi-*.json
